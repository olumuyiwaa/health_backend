# ─── App ───────────────────────────────────────
NODE_ENV=development
PORT=8000
API_PREFIX=/api/v1
APP_NAME="Healthcare Staffing Platform"
FRONTEND_URL=https://app.yourdomain.com
ADMIN_URL=https://admin.yourdomain.com

# ─── Database ──────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/healthcare_staffing

# ─── JWT ───────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-min-64-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_REFRESH_EXPIRES_IN=30d

# ─── Email (SendGrid) ──────────────────────────
SENDGRID_API_KEY=SG.xxxx
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME="Healthcare Staffing"

# ─── SMS (Twilio) ──────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxx
TWILIO_AUTH_TOKEN=xxxx
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# ─── Push (Firebase) ───────────────────────────
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── DigitalOcean Spaces ───────────────────────
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACES_REGION=nyc3
DO_SPACES_BUCKET=your-bucket-name
DO_SPACES_KEY=your-spaces-access-key
DO_SPACES_SECRET=your-spaces-secret-key
DO_SPACES_CDN_ENDPOINT=https://your-bucket.nyc3.cdn.digitaloceanspaces.com
SIGNED_URL_EXPIRY=3600

# ─── Stripe ────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# ─── Google Maps ───────────────────────────────
GOOGLE_MAPS_API_KEY=AIzaxxxx

# ─── Geo / EVV ─────────────────────────────────
EVV_GEOFENCE_RADIUS_METERS=200

# ─── Rate Limiting ─────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ─── Redis ─────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Encryption ────────────────────────────────
FIELD_ENCRYPTION_KEY=32-char-hex-key-for-aes-256